[Unit]
Description=SHIVMUSIC Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_VPS_USER
WorkingDirectory=/REPLACE/WITH/ABSOLUTE/PATH/anjali-main
EnvironmentFile=/REPLACE/WITH/ABSOLUTE/PATH/anjali-main/.env
ExecStart=/REPLACE/WITH/ABSOLUTE/PATH/anjali-main/.venv/bin/python -m SHIVMUSIC
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target